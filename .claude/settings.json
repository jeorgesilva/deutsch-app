{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npx vitest run:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(npx wrangler d1 execute *--remote*)",
      "Bash(wrangler d1 execute *--remote*)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npm run db:seed:remote)",
      "Bash(npm run db:seed-templates:remote)",
      "Bash(npx wrangler r2 object put:*)",
      "Bash(wrangler r2 object put:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler pages deploy:*)",
      "Bash(npm run deploy:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./.env.local)",
      "Read(./**/.dev.vars)"
    ]
  }
}
