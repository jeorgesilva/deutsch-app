# Somente NOMES. Nunca valores. Copiar para .env (raiz, lido pelo pipeline via dotenv).
# Worker do app usa app/.dev.vars (local) / `wrangler pages secret put` (produção).
# Workers dos containers usam `wrangler secret put` em services/<container>/.

# ===== Pipeline (.env na raiz) =====

# --- Hugging Face: o MESMO token tem 3 nomes conforme o lugar ---
# pipeline chat_structured (hf:): lê HF_TOKEN, senão hugging_face_api_key
# pipeline chat() simples (hf:):  EXIGE hugging_face_api_key
#   -> no .env, definir hugging_face_api_key cobre os dois caminhos
hugging_face_api_key=
HF_TOKEN=
# (HUGGINGFACE_API_KEY é o nome no Worker do app e no Worker do generation-container,
#  que o repassa ao container como hugging_face_api_key; HF_TOKEN também é o secret do CI/promptfoo)

GEMINI_API_KEY=
CLAUDE_API_KEY=

# Azure OpenAI: lê openai_key_1, senão AZURE_OPENAI_API_KEY
openai_key_1=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# Public AI
public_ai=
PUBLICAI_BASE_URL=

# --- Escrita no D1 ---
# D1_HTTP_API_TOKEN definido -> usa D1 HTTP API (caminho do container)
# senão wrangler local; D1_REMOTE não-vazio -> wrangler --remote
D1_HTTP_API_TOKEN=
D1_REMOTE=

# ===== Worker do app (app/.dev.vars) =====
# PHONETIC_SERVICE_URL=
# PHONETIC_SHARED_SECRET=
# HUGGINGFACE_API_KEY=
# GENERATION_SERVICE_URL=
# GENERATION_SHARED_SECRET=

# ===== Worker do generation-container (wrangler secret put) =====
# HUGGINGFACE_API_KEY=      -> repassado como hugging_face_api_key
# CLOUDFLARE_API_TOKEN=     -> repassado como D1_HTTP_API_TOKEN
# GEMINI_API_KEY=
# GENERATION_SHARED_SECRET=

# ===== Worker do phonetic-container (wrangler secret put) =====
# PHONETIC_SHARED_SECRET=
